{
  "mcpServers": {
    "github": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-github"],
      "env": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "$COPILOT_MCP_GITHUB_TOKEN"
      },
      "tools": [
        "create_issue",
        "get_issue",
        "list_issues",
        "update_issue",
        "create_pull_request",
        "get_pull_request",
        "list_pull_requests",
        "get_pull_request_diff",
        "list_commits",
        "get_commit",
        "list_tags",
        "get_tag"
      ]
    },
    "filesystem": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-filesystem", "./src"],
      "tools": [
        "read_file",
        "read_multiple_files",
        "write_file",
        "create_directory",
        "list_directory",
        "move_file",
        "search_files",
        "get_file_info"
      ]
    },
    "git": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-git", "--repository", "."],
      "tools": [
        "git_status",
        "git_diff",
        "git_diff_staged",
        "git_log",
        "git_show",
        "git_branch"
      ]
    },
    "postgres": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-postgres", "$COPILOT_MCP_POSTGRES_URL"],
      "env": {
        "POSTGRES_URL": "$COPILOT_MCP_POSTGRES_URL"
      },
      "tools": [
        "query",
        "describe_table",
        "list_tables",
        "list_schemas"
      ]
    },
    "mongodb": {
      "command": "npx",
      "args": ["-y", "mcp-mongo-server"],
      "env": {
        "MONGODB_URI": "$COPILOT_MCP_MONGODB_URI"
      },
      "tools": [
        "find",
        "list_collections",
        "describe_collection",
        "aggregate"
      ]
    }
  }
}