{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System": "Warning"
      }
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "{{SECRET}}"
  },
  "Jwt": {
    "Issuer": "StickerManagerApi",
    "Audience": "StickerManagerClient"
  }
}
